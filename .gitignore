# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Local-only records: real ledger/payment/bill/party/employee data SQL
# lives here so it is never committed. See db/MIGRATIONS.md §6
/.private-data/

# local patch/scratch artifacts
*.patch

# single package manager: npm / package-lock.json (see README)
bun.lock
yarn.lock
pnpm-lock.yaml

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
