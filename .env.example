# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only, bypasses Row Level Security. Never expose to the
# browser, never prefix with NEXT_PUBLIC_. Used only in Server Functions/
# Route Handlers that have already verified the caller's identity and
# capability (see src/lib/auth/require-capability.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
