# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only, bypasses Row Level Security. Never expose to the
# browser, never prefix with NEXT_PUBLIC_. Used only in Server Functions/
# Route Handlers that have already verified the caller's identity and
# capability (see src/lib/auth/require-capability.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Automation (added 2026-08-08) ---

# 32 random bytes, base64-encoded — used to encrypt marketplace/courier API
# keys before they're stored in the DB (see src/lib/crypto/secret-box.ts).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CHANGING THIS AFTER SECRETS ARE STORED MAKES THEM UNDECRYPTABLE — treat it
# like a master password. Back it up somewhere safe (e.g. your password
# manager), not just in Vercel's env var UI.
ENCRYPTION_KEY=

# Random secret Vercel Cron uses to authenticate its own request to
# /api/cron/sync-orders (Vercel sends this automatically as `Authorization:
# Bearer <value>` when this env var is set — see vercel.json).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# HMAC secret the courier gives you for verifying webhook authenticity
# (src/app/api/webhooks/courier/route.ts). Different per courier if you
# eventually wire up more than one — for now, one shared value.
COURIER_WEBHOOK_SECRET=

# The employee id of a dedicated "System / API Sync" employee row (create
# one per company, active=false so it can never log in) — used to attribute
# auto-imported orders' entry_by_employee_id. See setup step in
# src/app/api/cron/sync-orders/route.ts.
SYSTEM_SYNC_EMPLOYEE_ID=

# --- Courier tracking (added 2026-08-10) — Delhivery, UPS, FedEx, Shiprocket ---

# Delhivery push webhook (src/app/api/webhooks/courier/delhivery/route.ts).
# Generate a random token, put it here AND set it as the custom
# "Authorization: Bearer <this>" header Delhivery sends with their webhook
# callback (configured in Delhivery's dashboard, not an env var on their
# side — there's no crypto signature for this one, just a shared header).
DELHIVERY_WEBHOOK_TOKEN=

# Delhivery's own REST API token (client credential THEY issued to us — the
# opposite direction from DELHIVERY_WEBHOOK_TOKEN above, which we issue to
# THEM). Used as the `Authorization: Token <this>` header on calls we make
# TO Delhivery's APIs (e.g. their client-side Track API, shipment/waybill
# APIs) — NOT consumed anywhere yet as of 2026-08-10; reserved for whichever
# Delhivery API integration gets built next (e.g. a polling fallback
# alongside the push webhook, or order manifestation).
DELHIVERY_API_TOKEN=

# UPS Track Alert push webhook — a matched PAIR of secrets, see
# src/app/api/webhooks/courier/ups/token/route.ts's header comment for the
# full OAuth2 client_credentials flow this implements.
#   UPS_WEBHOOK_CLIENT_ID / UPS_WEBHOOK_CLIENT_SECRET — give these to UPS
#     when registering the subscription's "credentialsUrl" as
#     https://<your-domain>/api/webhooks/courier/ups/token
#   UPS_WEBHOOK_TOKEN_SECRET — stays private, never given to UPS, used to
#     sign the bearer tokens the token endpoint issues
UPS_WEBHOOK_CLIENT_ID=
UPS_WEBHOOK_CLIENT_SECRET=
UPS_WEBHOOK_TOKEN_SECRET=

# FedEx — POLLING, not a webhook (see src/app/api/cron/poll-fedex-tracking/
# route.ts's header comment for why). Standard FedEx Developer Portal
# OAuth2 client_credentials app credentials (developer.fedex.com — create
# a project, get a Track API-scoped client id/secret).
FEDEX_API_CLIENT_ID=
FEDEX_API_CLIENT_SECRET=
# Only set this to the sandbox URL (https://apis-sandbox.fedex.com) while
# testing with FedEx's test tracking numbers — leave unset in production,
# it defaults to https://apis.fedex.com.
FEDEX_API_BASE_URL=

# Shiprocket push webhook (src/app/api/webhooks/courier/shiprocket/route.ts).
# Generate a random token, put it here AND set the same value as the
# "security token" in Shiprocket's dashboard: Settings -> API -> Webhooks
# (Shiprocket sends it back as an `x-api-key` header on every callback —
# their own docs call this token optional, but this app requires it).
# IMPORTANT: per Shiprocket's own docs, the webhook URL itself must NOT
# contain the words "shiprocket", "kartrocket", "sr", or "kr".
SHIPROCKET_WEBHOOK_TOKEN=

# Aramex — POLLING, not a webhook, shares the poll-fedex-tracking cron job
# with FedEx (see that route's header comment for why — Vercel Hobby's
# 2-cron-job cap). Unlike every other courier here, Aramex has no separate
# API key: every call carries your FULL account credentials (the same
# ClientInfo block their Rate/Location/Shipping SOAP APIs use too). Get
# these from your Aramex account rep / the Aramex developer portal.
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=

# Shipglobal — NOT tracking-only like everything else above: this actually
# CREATES a real shipment + label + customs declaration (see
# db/2026-08-10-shipglobal.sql and src/app/dashboard/shipglobal/). Plain
# email+password login (customers.php) -> bearer token, re-authenticated on
# every call (no refresh-token flow in the docs provided). Get real
# credentials from your Shipglobal account rep — do NOT use the sample
# test@shipglobal.in account from their docs for anything real.
SHIPGLOBAL_EMAIL=
SHIPGLOBAL_PASSWORD=
# Only override if Shipglobal ever gives you a different base URL (e.g. a
# sandbox) — defaults to https://labels.shipglobal.in/api/v1 if unset.
SHIPGLOBAL_BASE_URL=
