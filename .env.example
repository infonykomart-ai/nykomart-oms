# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only, bypasses Row Level Security. Never expose to the
# browser, never prefix with NEXT_PUBLIC_. Used only in Server Functions/
# Route Handlers that have already verified the caller's identity and
# capability (see src/lib/auth/require-capability.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Automation (added 2026-08-08) ---

# 32 random bytes, base64-encoded — used to encrypt marketplace/courier API
# keys before they're stored in the DB (see src/lib/crypto/secret-box.ts).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CHANGING THIS AFTER SECRETS ARE STORED MAKES THEM UNDECRYPTABLE — treat it
# like a master password. Back it up somewhere safe (e.g. your password
# manager), not just in Vercel's env var UI.
ENCRYPTION_KEY=

# Random secret Vercel Cron uses to authenticate its own request to
# /api/cron/sync-orders (Vercel sends this automatically as `Authorization:
# Bearer <value>` when this env var is set — see vercel.json).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# HMAC secret the courier gives you for verifying webhook authenticity
# (src/app/api/webhooks/courier/route.ts). Different per courier if you
# eventually wire up more than one — for now, one shared value.
COURIER_WEBHOOK_SECRET=

# The employee id of a dedicated "System / API Sync" employee row (create
# one per company, active=false so it can never log in) — used to attribute
# auto-imported orders' entry_by_employee_id. See setup step in
# src/app/api/cron/sync-orders/route.ts.
SYSTEM_SYNC_EMPLOYEE_ID=
